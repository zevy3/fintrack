# Скопируйте в .env и подставьте свои значения. Файл .env в репозиторий не попадает.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/finance_tracker
CORS_ORIGINS=["http://localhost:5173"]

# Секрет подписи JWT: длинная случайная строка, например `openssl rand -hex 32`
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
